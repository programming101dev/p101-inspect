# p101-inspect is the offline bootstrap analyzer for captures produced by the
# instrumented wrapper stack.  It deliberately links only lib_error and
# lib_tool_event: creating a p101_env here would make analysis emit observations
# about itself and would introduce p101-inspect -> lib_env -> lib_tool_event
# feedback into the mechanism it is validating.  These semantic declaration
# identities are therefore the complete admitted host-runtime boundary for the
# native analyzer; additions remain strict-audit failures until reviewed here.
src/inspect_main.c		c:@F@calloc
